<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — SmartWaste</title>
    <link rel="stylesheet" href="{{ asset('authentication/css/login.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <div class="logo-dot"></div>
            <div class="logo-name">SmartWaste</div>
        </div>
        <p class="login-title">Veuillez vous connecter pour continuer</p>

        {% if error %}
            <div class="alert alert-danger" style="color: #dc3545; text-align: center; margin-bottom: 15px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div style="margin-bottom: 15px; text-align: center;">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
        {% endif %}

        <div class="role-selection">
            <button class="role-btn active" id="btn-admin" onclick="selectRole('admin')">Administrateur</button>
            <button class="role-btn" id="btn-user" onclick="selectRole('user')">Citoyen</button>
        </div>

        <form id="loginForm" method="post">
            <div class="form-group">
                <label class="form-label">Adresse Email</label>
                <input type="email" value="{{ last_username }}" name="email" class="form-input" placeholder="exemple@smart.tn" autocomplete="email" required autofocus>
            </div>
            <div class="form-group">
                <label class="form-label">Mot de passe</label>
                <input type="password" name="password" class="form-input" placeholder="••••••••" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="checkbox mb-3" style="margin-bottom: 15px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="_remember_me" id="remember_me">
                <label for="remember_me">Se souvenir de moi</label>
            </div>
            <button type="submit" class="btn-login">Se connecter</button>
        </form>

        <div class="footer-links">
            <p><a href="#">Mot de passe oublié ?</a></p>
            <p class="mt-10">Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
        </div>
    </div>

    <script src="{{ asset('authentication/js/login.js') }}"></script>
</body>
</html>
