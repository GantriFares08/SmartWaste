{% extends 'base_citoyen.html.twig' %}

{% block title %}SmartWaste — Nouveau Signalement{% endblock %}

{% block citoyen_content %}
<div class="page active" id="page-u-signal">
    <div class="topbar"><span class="page-title">Nouveau signalement</span></div>
    <div class="content">

        {% for msg in app.flashes('success') %}
            <div style="background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; border-radius:8px; padding:12px 16px; margin-bottom:16px; display:flex; align-items:center; gap:10px;">
                <i class="ti ti-circle-check" style="font-size:18px;"></i> {{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; border-radius:8px; padding:12px 16px; margin-bottom:16px; display:flex; align-items:center; gap:10px;">
                <i class="ti ti-alert-circle" style="font-size:18px;"></i> {{ msg }}
            </div>
        {% endfor %}

        <div class="card" style="padding:20px">
            <form method="POST" enctype="multipart/form-data">

                <div class="form-group">
                    <label class="form-label">Type de problème <span style="color:red">*</span></label>
                    <select name="type" required style="width:100%; padding:10px; border:1px solid var(--color-border); border-radius:8px; background:var(--color-bg-secondary); color:var(--color-text-primary);">
                        <option value="">-- Sélectionnez une catégorie --</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Titre du signalement <span style="color:red">*</span></label>
                    <input type="text" name="titre" required placeholder="Ex: Poubelle débordante avenue Bourguiba"
                           style="width:100%; padding:10px; border:1px solid var(--color-border); border-radius:8px; background:var(--color-bg-secondary); color:var(--color-text-primary);">
                </div>

                <div class="form-group">
                    <label class="form-label">Localisation <span style="color:red">*</span></label>
                    <p style="font-size:13px; color:var(--color-text-tertiary); margin-top:0; margin-bottom:10px;">
                        <i class="ti ti-info-circle"></i> Cliquez sur une <b>poubelle verte</b> pour la lier, ou cliquez n'importe où sur la carte pour obtenir l'adresse automatiquement.
                    </p>

                    <input type="hidden" name="poubelle_id" id="poubelle_id">
                    <input type="text" name="adresse" id="adresse"
                           placeholder="Adresse détectée automatiquement après clic sur la carte..."
                           style="width:100%; padding:10px; border:1px solid var(--color-border); border-radius:8px; background:var(--color-bg-secondary); color:var(--color-text-primary); margin-bottom:12px;">

                    <div id="signal-map" style="height:280px; border-radius:10px; border:1px solid var(--color-border); overflow:hidden;"></div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description <span style="color:red">*</span></label>
                    <textarea name="description" required placeholder="Décrivez le problème avec le plus de détails possible..."
                              style="width:100%; padding:10px; border:1px solid var(--color-border); border-radius:8px; min-height:100px; resize:vertical; background:var(--color-bg-secondary); color:var(--color-text-primary);"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Photo / Pièce jointe <span style="color:var(--color-text-tertiary); font-weight:400;">(facultatif)</span></label>
                    <div style="border:2px dashed var(--color-border); border-radius:10px; padding:30px; text-align:center; background:var(--color-bg-secondary); cursor:pointer;" onclick="document.getElementById('file-upload').click()">
                        <i class="ti ti-cloud-upload" style="font-size:32px; color:var(--color-text-tertiary); margin-bottom:8px; display:block;"></i>
                        <span style="color:var(--color-text-secondary); font-size:14px;" id="file-name-display">Cliquez pour parcourir ou glissez un fichier ici</span>
                        <div style="color:var(--color-text-tertiary); font-size:12px; margin-top:5px;">Formats acceptés : .pdf, .jpg, .png</div>
                        <input type="file" id="file-upload" name="piece_jointe" accept=".pdf,image/*" style="display:none;"
                               onchange="document.getElementById('file-name-display').innerText = this.files[0] ? this.files[0].name : 'Cliquez pour parcourir...'">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:12px;">
                    <i class="ti ti-send"></i> Envoyer le signalement
                </button>
            </form>
        </div>
    </div>
</div>


<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    if (typeof signalMap !== 'undefined' && signalMap) {
        try {
            signalMap.remove();
        } catch(e) {}
        signalMap = undefined;
    }

    var signalMap;

    function initCitoyenSignalMap() {
        const container = document.getElementById('signal-map');
        if (!container) return;

        // Leaflet container clean check
        if (container._leaflet_id) {
            container.outerHTML = container.outerHTML; // clones element to strip events
        }

        signalMap = L.map('signal-map').setView([36.8065, 10.1815], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(signalMap);

        const customIcon = L.divIcon({
            className: 'custom-div-icon',
            html: "<div style='background-color:#1D9E75; width:14px; height:14px; border-radius:50%; border:2px solid white; box-shadow:0 0 5px rgba(0,0,0,0.3)'></div>",
            iconSize: [14, 14],
            iconAnchor: [7, 7]
        });

        const selectedIcon = L.divIcon({
            className: 'selected-div-icon',
            html: "<div style='background-color:#ff4757; width:16px; height:16px; border-radius:50%; border:2px solid white; box-shadow:0 0 8px rgba(255,71,87,0.6)'></div>",
            iconSize: [16, 16],
            iconAnchor: [8, 8]
        });

        const data = [
            {% for p in poubelles %}
            {
                id: {{ p.id }},
                lat: {{ p.latitude }},
                lng: {{ p.longitude }},
                ref: "{{ p.reference }}",
                cat: "{{ p.categorie ? p.categorie.nom : '' }}"
            },
            {% endfor %}
        ];

        let activeMarker = null;
        let tempMarker = null;

        data.forEach(p => {
            let marker = L.marker([p.lat, p.lng], {icon: customIcon}).addTo(signalMap);
            
            marker.on('click', function(e) {
                L.DomEvent.stopPropagation(e);
                // Reset previous marker
                if(activeMarker) {
                    activeMarker.marker.setIcon(customIcon);
                }
                if (tempMarker) {
                    signalMap.removeLayer(tempMarker);
                    tempMarker = null;
                }
                
                // Set new marker as selected
                marker.setIcon(selectedIcon);
                activeMarker = { marker: marker, data: p };
                
                // Update form fields
                document.getElementById('poubelle_id').value = p.id;
                document.getElementById('adresse').value = "Poubelle: " + p.ref + " (" + p.cat + ")";
                
                marker.bindPopup(`<b>Poubelle: ${p.ref}</b><br>Sélectionnée pour ce signalement.`).openPopup();
            });
        });

        signalMap.on('click', function(e) {
            if(activeMarker) {
                activeMarker.marker.setIcon(customIcon);
                activeMarker = null;
            }
            
            document.getElementById('poubelle_id').value = "";
            document.getElementById('adresse').value = "Recherche de l'adresse...";
            
            if (tempMarker) {
                tempMarker.setLatLng(e.latlng);
            } else {
                tempMarker = L.marker(e.latlng, {icon: selectedIcon}).addTo(signalMap);
            }
            tempMarker.bindPopup("<b>Lieu sélectionné</b><br>En attente d'adresse...").openPopup();
            
            fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${e.latlng.lat}&lon=${e.latlng.lng}`)
                .then(response => response.json())
                .then(data => {
                    if (data && data.display_name) {
                        let shortAddress = data.display_name.split(',').slice(0, 3).join(', ');
                        document.getElementById('adresse').value = shortAddress;
                        tempMarker.getPopup().setContent(`<b>Lieu sélectionné</b><br>${shortAddress}`);
                    } else {
                        document.getElementById('adresse').value = `Lat: ${e.latlng.lat.toFixed(5)}, Lng: ${e.latlng.lng.toFixed(5)}`;
                        tempMarker.getPopup().setContent(`<b>Lieu sélectionné</b><br>Lat: ${e.latlng.lat.toFixed(5)}`);
                    }
                })
                .catch(() => {
                    document.getElementById('adresse').value = `Lat: ${e.latlng.lat.toFixed(5)}, Lng: ${e.latlng.lng.toFixed(5)}`;
                });
        });

        setTimeout(function() {
            if (signalMap) {
                signalMap.invalidateSize();
            }
        }, 100);

        if ("geolocation" in navigator && signalMap) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                if (signalMap) {
                    signalMap.setView([lat, lng], 14);
                }
            }, function(error) {
                console.log("Geolocation error:", error);
            });
        }
    }

    // Attach to both standard page loads and Turbo loads
    document.addEventListener('DOMContentLoaded', initCitoyenSignalMap);
    document.addEventListener('turbo:load', initCitoyenSignalMap);
</script>
{% endblock %}
