{% extends 'base_citoyen.html.twig' %}

{% block title %}SmartWaste — Carte Citoyenne{% endblock %}

{% block citoyen_content %}
<div class="page active" id="page-u-map">
    <div class="topbar"><span class="page-title">Points de collecte à proximité</span></div>
    <div class="content">
        <div class="card" style="padding:0; overflow:hidden; position:relative; height:450px;">
            <div id="citoyen-full-map" style="height:100%; width:100%;"></div>
        </div>

        <div style="margin-top:20px; display:flex; gap:15px;">
            <div class="card" style="flex:1; padding:12px; display:flex; align-items:center; gap:10px;">
                <div style="width:12px; height:12px; border-radius:50%; background:#1D9E75;"></div>
                <span style="font-size:13px">Poubelle (Toutes catégories)</span>
            </div>
            <div class="card" style="flex:1; padding:12px; display:flex; align-items:center; justify-content:center;">
                <button class="btn btn-primary" style="width:100%;" onclick="centerOnUser()">
                    <i class="ti ti-target"></i> Ma position
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
(function () {
    var mapInstance = null;
    var userMarker  = null;

 
    var poubelles = {{ poubelles|map(p => {
        id:  p.id,
        lat: p.latitude,
        lng: p.longitude,
        ref: p.reference,
        cat: p.categorie ? p.categorie.nom : ''
    })|json_encode|raw }};

    var signalUrl = "{{ path('app_citoyen_signal') }}";

    function destroyMap() {
        if (mapInstance) {
            mapInstance.off();
            mapInstance.remove();
            mapInstance = null;
            userMarker  = null;
        }
    }

    function initMap() {
        var container = document.getElementById('citoyen-full-map');
        if (!container) return;

        if (container._leaflet_id) {
            destroyMap();
        }

        mapInstance = L.map('citoyen-full-map').setView([36.8065, 10.1815], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(mapInstance);

        var customIcon = L.divIcon({
            className: '',
            html: '<div style="background:#1D9E75;width:14px;height:14px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 5px rgba(0,0,0,.3)"></div>',
            iconSize:   [14, 14],
            iconAnchor: [7, 7]
        });

        poubelles.forEach(function (p) {
            L.marker([p.lat, p.lng], { icon: customIcon })
                .addTo(mapInstance)
                .bindPopup(
                    '<b>Poubelle\u00a0: ' + p.ref + '</b><br>' +
                    'Cat\u00e9gorie\u00a0: ' + (p.cat || '\u2014') + '<br><br>' +
                    '<a href="' + signalUrl + '" style="color:#1D9E75;font-weight:bold;">Signaler un probl\u00e8me</a>'
                );
        });

        setTimeout(function () {
            if (mapInstance) mapInstance.invalidateSize();
        }, 200);

        centerOnUser();
    }

    window.centerOnUser = function () {
        if (!mapInstance || !('geolocation' in navigator)) return;

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;

                mapInstance.setView([lat, lng], 15);

                if (userMarker) {
                    userMarker.setLatLng([lat, lng]);
                } else {
                    var userIcon = L.divIcon({
                        className: '',
                        html: '<div style="background:#185FA5;width:16px;height:16px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 10px rgba(24,95,165,.6)"></div>',
                        iconSize:   [16, 16],
                        iconAnchor: [8, 8]
                    });
                    userMarker = L.marker([lat, lng], { icon: userIcon })
                        .addTo(mapInstance)
                        .bindPopup('<b>Ma position</b>');
                }
                userMarker.openPopup();
            },
            function (err) {
                console.warn('G\u00e9olocalisation refus\u00e9e\u00a0:', err.message);
            }
        );
    };

    function bootstrap() {
        if (document.getElementById('citoyen-full-map')) {
            initMap();
        }
    }

    document.addEventListener('DOMContentLoaded',   bootstrap);
    document.addEventListener('turbo:load',         bootstrap);
    document.addEventListener('turbo:before-cache', destroyMap);
})();
</script>
{% endblock %}