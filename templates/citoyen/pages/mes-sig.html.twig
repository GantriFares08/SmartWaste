{% extends 'base_citoyen.html.twig' %}

{% block title %}SmartWaste — Mes Signalements{% endblock %}

{% block citoyen_content %}
<div class="page active" id="page-u-mes-sig">
    <div class="topbar">
        <span class="page-title">Mes signalements</span>
        <div class="topbar-right">
            <button class="btn btn-primary" onclick="window.location.href='{{ path('app_citoyen_signal') }}'">
                <i class="ti ti-plus"></i>Nouveau signalement
            </button>
        </div>
    </div>
    <div class="content">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success" style="color: #1D9E75; margin-bottom: 20px; padding: 15px; background: #1D9E7515; border-radius: 12px; display: flex; align-items: center; gap: 10px;">
                <i class="ti ti-circle-check" style="font-size: 20px"></i>
                {{ message }}
            </div>
        {% endfor %}

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
            {% for sig in signalements %}
                <div class="card" style="padding: 0; overflow: hidden; border-radius: 15px;">
                    <div style="height: 100px; background: {{ sig.statut == 'Traité' ? '#e6f7f1' : '#f0f4f8' }}; display: flex; align-items: center; justify-content: center; color: {{ sig.statut == 'Traité' ? '#1D9E75' : '#ccc' }};">
                        <i class="ti {{ sig.statut == 'Traité' ? 'ti-checkbox' : 'ti-clock' }}" style="font-size: 32px"></i>
                    </div>
                    <div style="padding: 15px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 11px; color: var(--color-text-tertiary)">Réf: #{{ sig.id }}</span>
                            {% set badge = sig.statut == 'Traité' ? 'green' : (sig.statut == 'En cours' ? 'amber' : 'red') %}
                            <span class="badge {{ badge }}">{{ sig.statut }}</span>
                        </div>
                        <h4 style="margin: 0 0 5px 0; font-size: 15px;">{{ sig.categorie ? sig.categorie.nom : 'Catégorie inconnue' }}</h4>
                        <p style="font-size: 13px; color: var(--color-text-secondary); margin-bottom: 15px; height: 3em; overflow: hidden;">
                            <i class="ti ti-map-pin" style="margin-right: 5px;"></i>{{ sig.poubelle ? sig.poubelle.reference : 'Lieu inconnu' }}
                        </p>
                        <div style="border-top: 1px solid var(--color-border); padding-top: 10px; display: flex; justify-content: space-between; font-size: 12px; color: var(--color-text-tertiary)">
                            <span>{{ sig.createdAt|date('d/m/Y') }}</span>
                            <a href="#" onclick="document.getElementById('modal-sig-{{ sig.id }}').style.display='flex'; return false;" style="color: var(--color-primary); text-decoration: none; font-weight: 600;">Détails</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card" style="grid-column: 1 / -1; padding: 40px; text-align: center;">
                    <p style="color: var(--color-text-tertiary)">Vous n'avez pas encore envoyé de signalements.</p>
                </div>
            {% endfor %}
        </div>
    </div>
    
    <!-- Modals -->
    {% for sig in signalements %}
    <div id="modal-sig-{{ sig.id }}" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 9999;">
        <div class="card" style="width: 100%; max-width: 500px; padding: 25px; border-radius: 16px; position: relative;">
            <button onclick="document.getElementById('modal-sig-{{ sig.id }}').style.display='none'" style="position: absolute; top: 20px; right: 20px; background: none; border: none; font-size: 20px; cursor: pointer; color: var(--color-text-secondary);">&times;</button>
            <h3 style="margin-top: 0; margin-bottom: 5px;">{{ sig.categorie ? sig.categorie.nom : 'Catégorie inconnue' }}</h3>
            <p style="font-size: 13px; color: var(--color-text-secondary); margin-top: 0; margin-bottom: 20px;">Fait le {{ sig.createdAt|date('d/m/Y à H:i') }} • Réf: #{{ sig.id }}</p>
            
            <div style="background: var(--color-background-secondary); padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                <h4 style="margin: 0 0 10px 0; font-size: 13px; color: var(--color-text-tertiary); text-transform: uppercase;">Description détaillée</h4>
                <p style="font-size: 14px; margin: 0; white-space: pre-wrap; line-height: 1.5;">{{ sig.description }}</p>
            </div>
            
            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <div style="flex: 1;">
                    <h4 style="margin: 0 0 5px 0; font-size: 12px; color: var(--color-text-tertiary);">Lieu</h4>
                    <p style="font-size: 14px; margin: 0; white-space: pre-wrap;">{{ sig.poubelle ? sig.poubelle.reference : 'Emplacement personnalisé' }}</p>
                </div>
                <div style="flex: 1;">
                    <h4 style="margin: 0 0 5px 0; font-size: 12px; color: var(--color-text-tertiary);">Statut</h4>
                    {% set badge = sig.statut == 'Traité' ? 'green' : (sig.statut == 'En cours' ? 'amber' : 'red') %}
                    <span class="badge {{ badge }}">{{ sig.statut }}</span>
                </div>
            </div>
            
            {% if sig.photo %}
            <div style="margin-bottom: 10px;">
                <a href="{{ asset('uploads/signalements/' ~ sig.photo) }}" target="_blank" class="btn btn-primary" style="width: 100%; justify-content: center;">
                    <i class="ti ti-photo"></i> Voir la pièce jointe
                </a>
            </div>
            {% endif %}
            
        </div>
    </div>
    {% endfor %}

</div>
{% endblock %}
