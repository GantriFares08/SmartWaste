{% extends 'base_admin.html.twig' %}

{% block title %}SmartWaste — Rapports{% endblock %}

{% block admin_content %}
<div class="page active" id="page-reports">
    <div class="topbar"><span class="page-title">Rapports et Analyses</span></div>
    <div class="content">
        
        <div class="kpi-row" style="margin-bottom: 20px;">
            <div class="kpi">
                <div class="kpi-lbl"><i class="ti ti-report"></i>Total Signalements</div>
                <div class="kpi-val blue">{{ stats.total }}</div>
                <div class="kpi-sub">Depuis le début</div>
            </div>
            <div class="kpi">
                <div class="kpi-lbl"><i class="ti ti-check"></i>Traités</div>
                <div class="kpi-val green">{{ stats.traite }}</div>
                <div class="kpi-sub">Problèmes résolus</div>
            </div>
            <div class="kpi">
                <div class="kpi-lbl"><i class="ti ti-clock"></i>En Cours</div>
                <div class="kpi-val amber">{{ stats.en_cours }}</div>
                <div class="kpi-sub">En attente d'intervention</div>
            </div>
            <div class="kpi">
                <div class="kpi-lbl"><i class="ti ti-percentage"></i>Efficacité</div>
                <div class="kpi-val">{{ stats.total > 0 ? ((stats.traite / stats.total) * 100)|number_format(0) : 0 }}%</div>
                <div class="kpi-sub">Taux de résolution</div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:20px">
            <div class="card" style="padding: 20px;">
                <div class="card-hd" style="border: none; padding: 0 0 15px 0;"><span class="card-title">Répartition par catégorie</span></div>
                <div style="height: 300px; display: flex; align-items: center; justify-content: center;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
            
            <div style="display:flex; flex-direction:column; gap:20px">
                <div class="card" style="padding:15px; text-align:center; flex:1; display:flex; flex-direction:column; justify-content:center;">
                    <i class="ti ti-file-text" style="font-size:32px; color:var(--color-primary); margin-bottom:10px; display:block"></i>
                    <div style="font-weight:600; font-size:14px">Rapport Global</div>
                    <div style="font-size:11px; color:var(--color-text-tertiary); margin-bottom:12px">Toutes les données en PDF</div>
                    <button class="btn btn-primary" style="width:100%; font-size:12px; justify-content:center;"><i class="ti ti-download"></i> Télécharger PDF</button>
                </div>
                <div class="card" style="padding:15px; text-align:center; flex:1; display:flex; flex-direction:column; justify-content:center;">
                    <i class="ti ti-file-analytics" style="font-size:32px; color:#1D9E75; margin-bottom:10px; display:block"></i>
                    <div style="font-weight:600; font-size:14px">Export Excel</div>
                    <div style="font-size:11px; color:var(--color-text-tertiary); margin-bottom:12px">Données brutes pour tableur</div>
                    <button class="btn btn-primary" style="width:100%; font-size:12px; background:#1D9E75; border-color:#1D9E75; justify-content:center;"><i class="ti ti-download"></i> Télécharger CSV</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('categoryChart').getContext('2d');
        const data = {
            labels: [
                {% for catName, count in categoriesStats %}
                    "{{ catName|escape('js') }}",
                {% endfor %}
            ],
            datasets: [{
                data: [
                    {% for catName, count in categoriesStats %}
                        {{ count }},
                    {% endfor %}
                ],
                backgroundColor: [
                    '#1D9E75', '#185FA5', '#BA7517', '#A32D2D', '#8b5cf6', '#0ea5e9', '#f59e0b'
                ],
                borderWidth: 0,
                hoverOffset: 4
            }]
        };

        new Chart(ctx, {
            type: 'doughnut',
            data: data,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            font: { family: "'DM Sans', sans-serif", size: 12 },
                            usePointStyle: true,
                            padding: 20
                        }
                    }
                },
                cutout: '70%'
            }
        });
    });
</script>
{% endblock %}
