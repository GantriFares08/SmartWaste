{% extends 'base_admin.html.twig' %}

{% block title %}SmartWaste — Paramètres{% endblock %}

{% block admin_content %}
<div class="page active" id="page-settings">
    <div class="topbar"><span class="page-title">Paramètres du Système</span></div>
    <div class="content">
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px">
            <div class="card" style="padding:20px">
                <div style="font-weight:600; margin-bottom:15px; font-size:16px"><i class="ti ti-settings-automation" style="margin-right:8px"></i>Général</div>
                <div class="form-group">
                    <label class="form-label">Nom de l'instance</label>
                    <input type="text" value="SmartWaste Tunis Central" class="form-control">
                </div>
                <div class="form-group">
                    <label class="form-label">Email de contact support</label>
                    <input type="email" value="support@smart.tn" class="form-control">
                </div>
                <div class="form-group">
                    <label class="form-label">Fuseau horaire</label>
                    <select class="form-control">
                        <option>(GMT+01:00) Tunis</option>
                        <option>(GMT+00:00) Londres</option>
                    </select>
                </div>
                <button class="btn btn-primary">Enregistrer les modifications</button>
            </div>

            <div class="card" style="padding:20px">
                <div style="font-weight:600; margin-bottom:15px; font-size:16px"><i class="ti ti-bell-ringing" style="margin-right:8px"></i>Notifications & Alertes</div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px">
                    <div>
                        <div style="font-size:14px; font-weight:500">Alertes Poubelle Pleine</div>
                        <div style="font-size:11px; color:var(--color-text-tertiary)">Notifier quand > 90%</div>
                    </div>
                    <input type="checkbox" checked>
                </div>
                <hr style="border:0; border-top:1px solid var(--color-border); margin:10px 0">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px">
                    <div>
                        <div style="font-size:14px; font-weight:500">Rapports Hebdomadaires</div>
                        <div style="font-size:11px; color:var(--color-text-tertiary)">Envoyer aux administrateurs</div>
                    </div>
                    <input type="checkbox" checked>
                </div>
                <hr style="border:0; border-top:1px solid var(--color-border); margin:10px 0">
                <div style="display:flex; justify-content:space-between; align-items:center">
                    <div>
                        <div style="font-size:14px; font-weight:500">Mode Maintenance</div>
                        <div style="font-size:11px; color:var(--color-text-tertiary)">Désactiver les nouveaux signalements</div>
                    </div>
                    <input type="checkbox">
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
