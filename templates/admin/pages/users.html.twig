{% extends 'base_admin.html.twig' %}

{% block title %}SmartWaste — Utilisateurs{% endblock %}

{% block admin_content %}
<div class="page active" id="page-users">
    <div class="topbar">
        <span class="page-title">Gestion des utilisateurs</span>
        <div class="topbar-right">
            <button class="btn btn-primary" onclick="window.location.href='{{ path('app_admin_add_admin') }}'">
                <i class="ti ti-user-plus"></i>Nouvel Admin
            </button>
        </div>
    </div>
    <div class="content">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success" style="color: #1D9E75; margin-bottom: 15px; padding: 10px; background: #1D9E7515; border-radius: 8px;">
                {{ message }}
            </div>
        {% endfor %}

        <div class="card">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th style="text-align: left; padding: 12px; border-bottom: 1px solid var(--color-border)">Utilisateur</th>
                        <th style="text-align: left; padding: 12px; border-bottom: 1px solid var(--color-border)">Email</th>
                        <th style="text-align: left; padding: 12px; border-bottom: 1px solid var(--color-border)">Rôles</th>
                        <th style="text-align: right; padding: 12px; border-bottom: 1px solid var(--color-border)">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td style="padding: 12px; border-bottom: 1px solid var(--color-border)">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div class="avatar" style="width: 32px; height: 32px; font-size: 12px;">{{ user.prenom|first|upper }}{{ user.nom|first|upper }}</div>
                                    <span>{{ user.prenom }} {{ user.nom }}</span>
                                </div>
                            </td>
                            <td style="padding: 12px; border-bottom: 1px solid var(--color-border); color: var(--color-text-tertiary)">{{ user.email }}</td>
                            <td style="padding: 12px; border-bottom: 1px solid var(--color-border)">
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge blue">Admin</span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="badge" style="background:#E6F1FB; color:#185FA5">Citoyen</span>
                                    {% else %}
                                        <span class="badge">{{ role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td style="padding: 12px; border-bottom: 1px solid var(--color-border); text-align: right;">
                                <div style="display: flex; justify-content: flex-end; gap: 5px;">
                                    <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn" title="Modifier" style="display: inline-flex; align-items: center; justify-content: center; padding: 6px;"><i class="ti ti-edit" style="font-size: 1.1rem;"></i></a>
                                    <a href="{{ path('app_admin_user_delete', {'id': user.id}) }}" class="btn" title="Supprimer" style="color: #dc3545; display: inline-flex; align-items: center; justify-content: center; padding: 6px;" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');"><i class="ti ti-trash" style="font-size: 1.1rem;"></i></a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
